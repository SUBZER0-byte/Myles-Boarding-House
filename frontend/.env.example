# Browser-visible settings only. Vite embeds VITE_* values in the frontend.
# Keep secrets, DATABASE_URL, and service-role keys out of this file.
# For Vercel, add these same VITE_* names in Project Settings > Environment
# Variables. Vercel does not upload this local file; redeploy after changes.

# Supabase API base URL: hosted projects use https://<project-ref>.supabase.co;
# self-hosted deployments use the HTTPS URL for the self-hosted API gateway.
# Do not append /rest/v1/; supabase-js derives the Auth, Data, and Storage paths.
# Required for the migrated authentication and profile flows.
# These are public client settings, not database passwords or service-role keys.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-project-publishable-key
