# Local Edge Function settings. Copy to supabase/.env for local function serving.
# Never put SUPABASE_SECRET_KEY or provider secrets in frontend/.env or VITE_* variables.
# Prefer the new Supabase API keys when available. The Edge Functions retain
# compatibility with the platform-provided legacy key names.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
APP_ALLOWED_ORIGINS=https://myles-boarding-house.vercel.app,http://localhost:5173
TEXTBEE_API_BASE=https://api.textbee.dev/api/v1
TEXTBEE_API_KEY=
# Optional; blank uses the account's default TextBee device.
TEXTBEE_DEVICE_ID=
# Set to exact lowercase "true" only when SMS sending is intentionally enabled.
TEXTBEE_ENABLED=false
# Gemini is the only chatbot provider; configure the real key in ignored supabase/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional S3-compatible endpoint for trusted server-side S3 clients only.
# The frontend uses supabase-js with VITE_SUPABASE_URL instead.
SUPABASE_STORAGE_S3_ENDPOINT=
SUPABASE_STORAGE_S3_REGION=

# Only needed temporarily when running the one-time Admin bootstrap.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_PASSWORD=
