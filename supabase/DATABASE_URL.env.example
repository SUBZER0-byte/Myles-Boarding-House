# Use only for trusted database tools such as Supabase CLI migrations.
# Copy this file to supabase/.env.db and replace the placeholders using the
# exact connection string shown in Supabase Dashboard > Connect.
# Never place DATABASE_URL in frontend/.env, Vercel client variables, or browser code.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
